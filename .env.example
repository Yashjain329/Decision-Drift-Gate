# Optional live proposal configuration. Copy to .env and fill locally. See docs/PROVIDERS.md.
# Pick ONE provider with DDG_PROVIDER (default gemini_api):
#   gemini_api  anthropic_api  openai_api  bedrock  claude_cli  codex_cli  custom_cli
DDG_PROVIDER=gemini_api
DDG_MODEL=
# gemini_api
GEMINI_API_KEY=
DDG_GEMINI_MODEL=gemini-3.8-flash
# anthropic_api
# ANTHROPIC_API_KEY=
# openai_api (any OpenAI-compatible server: set OPENAI_BASE_URL, e.g. http://localhost:11434/v1 for Ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# bedrock: AWS_BEARER_TOKEN_BEDROCK, or boto3 credentials (profile/SSO/role); region is required
# DDG_AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=
# CLI agents use your subscription login; no key needed: claude_cli, codex_cli
# custom_cli: JSON array, prompt on stdin, answer on stdout. {model} is replaced by DDG_MODEL
# DDG_CLI_COMMAND=["gemini","-p","Answer the prompt on stdin","-m","{model}"]
# Per-call limit in seconds (1-600). Defaults: 30 for APIs, 180 for CLI agents.
# DDG_PROVIDER_TIMEOUT=
